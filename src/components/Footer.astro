---
import { GITHUB_ORG, NPM_ORG, products } from "../data/site";
import Wordmark from "./Wordmark.astro";
---

<footer class="site-footer">
  <div class="container footer-main">
    <div style="display: flex; flex-direction: column; gap: 16px; max-width: 360px">
      <Wordmark label="BYO" />
      <p class="body muted" style="font-size: 14px">Open-source packages for better-auth apps. MIT licensed.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <span class="faint" style="padding-bottom: 8px">packages</span>
        {products.map((p) => <a href={`/${p.slug}`}>{p.slug}</a>)}
      </div>
      <div class="footer-col">
        <span class="faint" style="padding-bottom: 8px">project</span>
        <a href="/docs/notifications/quickstart">docs</a>
        <a href="/conventions">conventions</a>
        <a href={GITHUB_ORG}>github ↗</a>
        <a href={NPM_ORG}>npm ↗</a>
      </div>
    </div>
  </div>
  <div class="container footer-legal">
    <span>Community project. Not affiliated with the better-auth team.</span>
    <span>byo.dev</span>
  </div>
</footer>
