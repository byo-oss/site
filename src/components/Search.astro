---
// ⌘K search over the Pagefind index built by `pnpm build`. Behaviour lives in scripts/ui.ts.
const suggestions = [
  { title: "Quickstart", group: "notifications", href: "/docs/notifications/quickstart" },
  { title: "Server API", group: "notifications", href: "/docs/notifications/api" },
  { title: "Options", group: "notifications", href: "/docs/notifications/options" },
  { title: "Notify an organization", group: "notifications", href: "/docs/notifications/organizations" },
  { title: "Support quickstart", group: "support", href: "/docs/support/quickstart" },
  { title: "Support server API", group: "support", href: "/docs/support/api" },
  { title: "Support options", group: "support", href: "/docs/support/options" },
  { title: "Entitlements quickstart", group: "entitlements", href: "/docs/entitlements/quickstart" },
  { title: "Entitlements server API", group: "entitlements", href: "/docs/entitlements/api" },
  { title: "Conventions", group: "byo", href: "/conventions" },
];
---

<dialog id="search" class="search-dialog" aria-labelledby="search-label">
  <div class="search-box">
    <div class="search-input-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="M16 16l4.5 4.5"></path>
      </svg>
      <label id="search-label" for="search-input" class="sr-only">Search docs</label>
      <input
        id="search-input"
        type="search"
        placeholder="Search docs, APIs, conventions"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="search-esc" data-search-close aria-label="Close search">esc</button>
    </div>
    <div id="search-results" class="search-results" role="listbox" aria-label="Results">
      <div class="search-group">suggested</div>
      {
        suggestions.map((s) => (
          <a href={s.href} class="search-result" role="option" aria-selected="false">
            <span class="search-result-title">{s.title}</span>
            <span class="search-result-group">{s.group}</span>
          </a>
        ))
      }
    </div>
    <div class="search-foot">
      <span>↑↓ move</span><span>↵ open</span><span>esc close</span><span class="search-foot-end">all byo docs</span>
    </div>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100vh - 160px);
    margin: 88px auto auto;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    box-shadow: 0 24px 64px var(--shadow);
  }

  .search-dialog::backdrop {
    background: var(--scrim);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .search-input-row input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--fg);
    font: inherit;
    font-size: 16px;
  }

  .search-input-row input::-webkit-search-cancel-button {
    display: none;
  }

  .search-esc {
    min-height: 32px;
    padding: 0 8px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .search-results {
    max-height: min(420px, calc(100vh - 300px));
    overflow-y: auto;
    padding: 6px 0 10px;
  }

  .search-group {
    padding: 14px 16px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    text-decoration: none;
    color: var(--fg);
  }

  .search-result:hover,
  .search-result[aria-selected="true"] {
    background: var(--hover);
    color: var(--fg);
  }

  .search-result-title {
    font-size: 14px;
  }

  .search-result-group {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .search-result-excerpt {
    grid-column: 1 / -1;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-3);
  }

  .search-result-excerpt mark {
    background: none;
    color: var(--fg);
    font-weight: 500;
  }

  .search-empty {
    margin: 0;
    padding: 24px 16px;
    font-size: 14px;
    color: var(--text-3);
  }

  .search-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .search-foot-end {
    margin-left: auto;
  }
</style>
