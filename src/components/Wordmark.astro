---
import { WORDMARK_PATH } from "../lib/wordmark";
// The BYO pixel wordmark, drawn on a 49×13 grid. Scale by whole numbers so pixels stay crisp.
interface Props {
  scale?: number;
  label?: string;
  class?: string;
}

const { scale = 2, label, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 49 13"
  width={49 * scale}
  height={13 * scale}
  shape-rendering="crispEdges"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <path fill="currentColor" d={WORDMARK_PATH}></path>
</svg>
