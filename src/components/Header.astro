---
import { GITHUB_ORG, products } from "../data/site";
import Wordmark from "./Wordmark.astro";

type Current = "notifications" | "support" | "mailer" | "conventions" | "docs";

interface Props {
  current?: Current;
  docs?: boolean;
}

const { current, docs = false } = Astro.props;
const productCurrent = products.some((p) => p.slug === current);
---

<header class:list={["site-header", { "is-docs": docs }]}>
  <div class="container">
    <div class="brand">
      <a href="/" class="brand-link" aria-label="BYO home"><Wordmark /></a>
      {docs && <a href="/docs/notifications/quickstart" class="brand-suffix">/ docs</a>}
    </div>

    {
      docs && (
        <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" />
            <path d="M16 16l4.5 4.5" />
          </svg>
          <span>Search docs</span>
          <kbd>⌘K</kbd>
        </button>
      )
    }

    <nav class="main-nav" aria-label="Main">
      <div class="popover-anchor">
        <button
          type="button"
          class:list={["nav-trigger", { "is-current": productCurrent }]}
          aria-expanded="false"
          aria-controls="products-menu"
          data-popover
        >
          products
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </button>
        <div id="products-menu" class="popover" hidden>
          <div class="popover-label">products</div>
          {
            products.map((p) => (
              <a href={`/${p.slug}`} class="menu-item" aria-current={current === p.slug ? "page" : undefined}>
                <span class="menu-item-top">
                  <span>{p.name}</span>
                  {p.version ? <span class="badge badge-solid">v{p.version}</span> : <span class="badge badge-dashed">{p.status}</span>}
                </span>
                <span class="menu-item-text">{p.menuText}</span>
              </a>
            ))
          }
          <div class="popover-foot">
            <a href="/#products">all products →</a>
            <a href="/docs/notifications/quickstart">docs →</a>
          </div>
        </div>
      </div>
      <a href="/docs/notifications/quickstart" aria-current={current === "docs" ? "page" : undefined}>docs</a>
      <a href="/conventions" aria-current={current === "conventions" ? "page" : undefined}>conventions</a>
      <a href={GITHUB_ORG}>github ↗</a>
    </nav>
    <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Toggle light and dark theme">
      <svg class="icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
      </svg>
    </button>
  </div>
</header>
