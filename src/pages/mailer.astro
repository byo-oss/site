    border-bottom: 2px solid transparent;
    color: var(--text-2);
    text-align: left;
    cursor: pointer;
  }

  .pick-item:hover {
    background: var(--hover);
    color: var(--fg);
  }

  .pick-item[aria-selected="true"] {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

