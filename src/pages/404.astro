---
import Frame from "../components/Frame.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="container" style="padding-block: 96px">
    <Frame gaps={[{ side: "top", at: "60%" }, { side: "left", at: "40%" }]} innerStyle="padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 64px); display: flex; flex-direction: column; align-items: flex-start; gap: 20px">
      <div class="mono muted" style="font-size: 13px">&gt;_ 404</div>
      <h1 class="h1">Nothing here.</h1>
      <p class="lead" style="margin: 0">The page moved or never existed. Try search, or start from one of these.</p>
      <div class="btn-row">
        <a href="/" class="btn btn-solid">byo.dev</a>
        <a href="/docs/notifications/quickstart" class="btn">Docs</a>
        <button type="button" class="btn" data-search-open>Search ⌘K</button>
      </div>
    </Frame>
  </div>
</Base>
