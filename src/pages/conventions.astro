---
import CodeBlock from "../components/CodeBlock.astro";
import Frame from "../components/Frame.astro";
import { SPEC_URL } from "../data/site";
import Base from "../layouts/Base.astro";

const rules = [
  ["Naming and packaging", "1-naming-and-packaging", "The @byo-oss scope, one package per domain, subpath exports for client, react and providers."],
  ["Plugin shape", "2-plugin-shape-plugin", "The plugin id doubles as the endpoint prefix. Renamable schema, typed error codes, misconfiguration fails at boot, and queries that hold on every adapter, D1 included."],
  ["Identity", "3-identity", "People are better-auth users, tenants are organizations. No package keeps its own user table."],
  ["Access and permissions", "4-access-and-permissions", "Every endpoint is server-only, own-rows or permission-gated. Packages check permissions, never role names."],
  ["Background work", "5-background-work", "One sweep endpoint per package, called from any scheduler. Leased claims, backoff, at-least-once."],
  ["Data lifecycle", "6-data-lifecycle", "Deleting a user, an organization or a membership removes what the package holds about them, on adapters with or without foreign keys."],
  ["UI", "7-ui-when-theres-a-react-export", "Headless hooks first. Components on shadcn variables, keyboard-ready, every string overridable."],
  ["Docs and tests", "8-docs-and-tests", "One README outline, an AGENTS.md for coding agents, tests against a real better-auth instance, strict semver."],
  ["Exit path", "9-exit-path", 'An "Outgrowing this" section, a documented schema, a data export, and uninstall steps.'],
  ["Providers", "10-providers", "Outside services plug in at the edges behind small interfaces. The package's own models stay the store of record."],
  ["Shared packages", "11-shared-packages", "Sweeps and cleanups declared under a byo key for @byo-oss/core. Email through a Mailer from @byo-oss/mailer."],
];

const proposed = [
  ["P1", "Domain events"],
  ["P2", "Notify through the inbox"],
  ["P3", "@byo-oss/identity"],
  ["P6", "Agent-native operations"],
  ["P7", "Preferences"],
  ["P8", "Bridges for the move out"],
];

const accessCode = `import { createAccessControl } from "better-auth/plugins/access";
import { defaultStatements } from "better-auth/plugins/organization/access";

export const statements = {
  ...defaultStatements,
  ...feedbackStatements, // exported by the package
  project: ["create", "update"],
} as const;

export const ac = createAccessControl(statements);`;
---

<Base title="Conventions" description="The rules that let BYO packages work as one system: one identity, one permission model, one way to run background work, one UI style." current="conventions">
  <div data-pagefind-body data-pagefind-meta="group:conventions">
    <section class="section">
      <div class="container" style="padding-block: clamp(48px, 7vw, 88px) clamp(48px, 6vw, 80px); display: flex; flex-direction: column; gap: 26px">
        <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">byo.dev</a><span class="faint">/</span><span>conventions</span></nav>
        <div class="meta-row">
          <span class="badge badge-dashed">draft v0</span>
          <span class="muted">2026-10-20</span>
          <span class="faint">·</span>
          <span class="muted">baseline better-auth ^1.7.7</span>
        </div>
        <h1 class="h1">Conventions</h1>
        <p class="tagline" style="max-width: 820px">The rules that let BYO packages work as one system instead of a pile of plugins.</p>
        <p class="lead" style="margin: 0; max-width: 680px">
          One identity, one permission model, one way to run background work, one UI style. Part 1 is required today. Its rules need plain better-auth
          primitives plus two shared packages, @byo-oss/core and @byo-oss/mailer. Part 2 holds proposals that aren't rules yet.
        </p>
        <div class="btn-row">
          <a href={SPEC_URL} class="btn btn-solid">Read SPEC.md ↗</a>
          <a href="https://github.com/byo-oss/conventions" class="btn">Discuss on GitHub ↗</a>
        </div>
      </div>
    </section>

    <div class="container conv-layout">
      <aside class="conv-toc" aria-label="On this page">
        <nav class="toc">
          <span class="toc-label">on this page</span>
          <a href="#tiers">Tiers</a>
          <a href="#part1">Part 1: Required</a>
          <a href="#example">Example: permissions</a>
          <a href="#part2">Part 2: Proposed</a>
          <a href="#keywords">Keywords</a>
        </nav>
      </aside>

      <div class="conv-body">
        <section id="tiers" aria-labelledby="tiers-h">
          <div class="eyebrow">[00] tiers</div>
          <h2 id="tiers-h" class="conv-h2">Plugin first. App when you must.</h2>
          <p class="body conv-lead">
            A package is an app only when it needs something a plugin can't give it: its own route tree, inbound webhooks or a separate database.
          </p>
          <div class="cells" style="--cell-min: 260px">
            <div class="cell" style="padding: 28px 24px; gap: 12px">
              <div style="display: flex; justify-content: space-between; gap: 12px"><h3 class="h3">Plugin</h3><span class="mono faint" style="font-size: 11px">default</span></div>
              <p class="body">A better-auth plugin. Tables come from the plugin schema, endpoints from createAuthEndpoint.</p>
              <CodeBlock code="betterAuth({ plugins: [inbox()] })" title="auth.ts" />
            </div>
            <div class="cell" style="padding: 28px 24px; gap: 12px">
              <div style="display: flex; justify-content: space-between; gap: 12px"><h3 class="h3">App</h3><span class="mono faint" style="font-size: 11px">none yet</span></div>
              <p class="body">A larger product with its own migrations and request handler, mapped to better-auth through an identify(request) adapter.</p>
              <CodeBlock code="identify(request) // → user, orgs, permissions" title="app.ts" />
            </div>
          </div>
        </section>

        <section id="part1" aria-labelledby="part1-h">
          <div class="eyebrow">[01] part 1 · required</div>
          <h2 id="part1-h" class="conv-h2" style="margin-bottom: 32px">Eleven rules every package follows.</h2>
          <ol class="rules">
            {
              rules.map(([title, anchor, text], i) => (
                <li>
                  <a href={`${SPEC_URL}#${anchor}`} class="rule">
                    <span class="mono faint rule-n">{String(i + 1).padStart(2, "0")}</span>
                    <span class="mono rule-title">{title}</span>
                    <span class="rule-text">{text}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="example" aria-labelledby="example-h">
          <div class="eyebrow">[02] example · §4.2</div>
          <h2 id="example-h" class="conv-h2">Permissions, not role names.</h2>
          <p class="body conv-lead">A package exports its permission statements. Your app spreads them into its catalog and decides which roles get which actions.</p>
          <CodeBlock code={accessCode} title="access.ts" />
        </section>

        <section id="part2" aria-labelledby="part2-h">
          <div class="eyebrow">[03] part 2 · proposed</div>
          <h2 id="part2-h" class="conv-h2">The glue, once two packages need it.</h2>
          <p class="body conv-lead">
            Proposals, not rules. Each one stays here until it's promoted, and nothing in Part 1 depends on them.
          </p>
          <div class="proposed">
            {
              proposed.map(([id, title]) => (
                <div class="proposed-item">
                  <div class="mono faint" style="font-size: 12px">{id}</div>
                  <div class="mono" style="margin-top: 8px; font-size: 15px">{title}</div>
                </div>
              ))
            }
          </div>
        </section>

        <section id="keywords" aria-labelledby="keywords-h">
          <Frame gaps={[{ side: "top", at: "80%" }]} innerStyle="padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 14px">
            <h2 id="keywords-h" class="mono" style="margin: 0; font-size: 16px">&gt;_ keywords</h2>
            <p class="body">
              <span class="mono" style="color: var(--fg)">MUST</span>, <span class="mono" style="color: var(--fg)">SHOULD</span> and
              <span class="mono" style="color: var(--fg)">MAY</span> mean what RFC 2119 says. A rule marked (plugin) applies to plugins only; everything
              else applies to both tiers.
            </p>
          </Frame>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .conv-layout {
    padding-block: 64px 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    align-items: flex-start;
  }

  .conv-toc {
    flex: 1 1 220px;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  @media (max-width: 860px) {
    .conv-toc {
      position: static;
    }
  }

  .conv-body {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 88px;
  }

  .conv-h2 {
    margin: 14px 0 12px;
    font-family: var(--font-mono);
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .conv-lead {
    margin-bottom: 32px;
    font-size: 16px;
  }

  .rules {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .rule {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding: 22px 8px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--fg);
  }

  .rule:hover {
    background: var(--hover);
    color: var(--fg);
  }

  .rule-n {
    flex: 0 0 40px;
    font-size: 13px;
  }

  .rule-title {
    flex: 1 1 200px;
    font-size: 16px;
    font-weight: 500;
  }

  .rule-text {
    flex: 2 1 320px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }

  .proposed {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px dashed var(--border);
    border-left: 1px dashed var(--border);
  }

  .proposed-item {
    padding: 20px 20px 24px;
    border-right: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
  }
</style>
