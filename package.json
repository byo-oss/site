{
  "name": "byo-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "docs:fetch": "node scripts/fetch-docs.ts",
    "dev": "pnpm docs:fetch && astro dev",
    "build": "pnpm docs:fetch && astro build && pagefind --site dist",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "^4.151.1"
  }
}
