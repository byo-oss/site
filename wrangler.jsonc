{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byo-site",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // A route (not a custom domain) so the zone's existing proxied DNS record keeps working.
  "routes": [
    { "pattern": "byo.dev/*", "zone_name": "byo.dev" }
  ]
}
